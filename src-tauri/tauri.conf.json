{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comparetica",
  "version": "0.3.0",
  "identifier": "com.mrtech0.comparetica",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Comparetica",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://apidatos.ree.es https://raw.githubusercontent.com https://github.com; img-src 'self' data: asset:; frame-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/MrTech0/Comparetica/main/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4M0YwOTY5QUVERTM5RTIKUldUaU9kNnVhUWsvR0Zpa2JxUTRKd1kzZVJvZWdkRTJTR3N3VW96ZnVUWFBwTDJhbHU1Mi83NXoK"
    }
  }
}
